# ===================================================================
# KONARK COMPUTERS — ENVIRONMENT VARIABLES
# ===================================================================

# Public Site Configuration
NEXT_PUBLIC_SITE_URL=https://www.konarkcomputers.in
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Firebase Server Admin SDK (Required for Firestore Database & Admin Auth)
FIREBASE_PROJECT_ID=konark-computers-prod
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@konark-computers-prod.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY=replace-with-firebase-private-key

# Firebase Client SDK (Safe for public client bundle in /admin)
NEXT_PUBLIC_FIREBASE_API_KEY=replace-with-firebase-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=konark-computers-prod.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=konark-computers-prod
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=konark-computers-prod.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890

# Feature Flag: Product Images (Vercel Blob)
# Set to 'false' to keep images inactive without schema changes; toggle to 'true' when ready.
NEXT_PUBLIC_ENABLE_PRODUCT_IMAGES=false

# Vercel Blob Token (For product images and quote PDFs)
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxxxxxxxxxxxxxxxx

# Google / Gmail SMTP (Used for contact form & automated quotation emails)
GMAIL_USER=your_gmail_account@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
CONTACT_RECIPIENT_EMAIL=omesh_tank@yahoo.com

# Cloudflare Turnstile Anti-Bot Protection (Optional)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAxxxxxxxxxxxxxxx
TURNSTILE_SECRET_KEY=0x4AAAAAAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

